{
  "name": "ferrovue",
  "version": "0.6.0",
  "description": "Vue templates compiled to Rust render functions: server-side rendering with no JavaScript at run time",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinsmir/ferrovue.git",
    "directory": "packages/ferrovue"
  },
  "homepage": "https://github.com/Kinsmir/ferrovue#readme",
  "bugs": "https://github.com/Kinsmir/ferrovue/issues",
  "keywords": [
    "vue",
    "ssr",
    "rust",
    "compiler",
    "hydration"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./link-router": {
      "types": "./dist/link-router.d.ts",
      "default": "./dist/link-router.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "default": "./dist/islands.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "ferrovue": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && cp ../../README.md ../../LICENSE-MIT ../../LICENSE-APACHE ."
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@intlify/message-compiler": "11.4.13",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/shared": "3.5.43",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@unhead/vue": "^3.4.2",
    "@vue/server-renderer": "3.5.43",
    "pinia": "^4.0.3",
    "playwright": "1.63.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "^5.3.1"
  },
  "peerDependencies": {
    "@unhead/vue": "~3.4.2",
    "pinia": "~4.0.3",
    "vite": ">=6",
    "vitest": ">=5",
    "vue": "~3.5.43",
    "vue-i18n": "~11.4.13",
    "vue-router": "~5.3.1"
  },
  "peerDependenciesMeta": {
    "@unhead/vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
