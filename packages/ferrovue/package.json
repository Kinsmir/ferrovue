{
  "name": "ferrovue",
  "version": "0.7.1",
  "description": "Vue templates compiled to Rust render functions: server-side rendering with no JavaScript at run time",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinsmir/ferrovue.git",
    "directory": "packages/ferrovue"
  },
  "homepage": "https://github.com/Kinsmir/ferrovue#readme",
  "bugs": "https://github.com/Kinsmir/ferrovue/issues",
  "keywords": [
    "vue",
    "ssr",
    "rust",
    "compiler",
    "hydration"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./link-router": {
      "types": "./dist/link-router.d.ts",
      "default": "./dist/link-router.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "default": "./dist/islands.js"
    },
    "./routes": {
      "types": "./dist/page-routes.d.ts",
      "default": "./dist/page-routes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./volar": {
      "types": "./dist/volar.d.ts",
      "default": "./dist/volar.js"
    },
    "./schema.json": "./schema.json"
  },
  "sideEffects": false,
  "bin": {
    "ferrovue": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && cp ../../README.md ../../LICENSE-MIT ../../LICENSE-APACHE ."
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@intlify/message-compiler": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/shared": "catalog:",
    "generic-names": "^4.0.0",
    "postcss": "^8.5.29",
    "postcss-modules-extract-imports": "^3.1.0",
    "postcss-modules-local-by-default": "^4.2.0",
    "postcss-modules-scope": "^3.2.1",
    "postcss-modules-values": "^4.0.0",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@unhead/vue": "catalog:",
    "@vue/language-core": "3.3.12",
    "@vue/language-service": "3.3.12",
    "@vue/server-renderer": "catalog:",
    "pinia": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-js": "npm:typescript@6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-uri": "3.2.0",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "peerDependencies": {
    "@unhead/vue": "~3.4.2",
    "@vue/language-core": "^3.3.0",
    "pinia": "~4.0.3",
    "vite": ">=6",
    "vitest": ">=5",
    "vue": "~3.5.43",
    "vue-i18n": "~11.4.13",
    "vue-router": "~5.3.1"
  },
  "peerDependenciesMeta": {
    "@unhead/vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@vue/language-core": {
      "optional": true
    }
  }
}
