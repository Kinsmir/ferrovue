{
  "name": "ferrovue-example-fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate": "ferrovue",
    "check": "ferrovue --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && vitest run --config vitest.adopter.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.2",
    "pinia": "^4.0.3",
    "vue": "3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "ferrovue": "workspace:*",
    "happy-dom": "^20.14.5",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
