{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "crates/ferrovue/tests/conformance/components/**",
    "crates/ferrovue/tests/conformance/stores/**",
    "crates/ferrovue/tests/conformance/types/**",
    "crates/ferrovue/tests/literal_props/components/**",
    "crates/ferrovue/tests/sanitised/components/**",
    "examples/greeting/components/**",
    "examples/dioxus/components/**",
    "examples/fullstack/adopter/*.test.ts",
    "examples/fullstack/browser/*.test.ts",
    "examples/fullstack/client/components/**",
    "examples/fullstack/client/main.ts",
    "examples/fullstack/client/pages/**",
    "packages/ferrovue/browser/*.test.ts",
    "packages/ferrovue/browser/entry.ts",
    "packages/ferrovue/browser/lazy-entry.ts",
    "scripts/inspect.ts"
  ],
  "ignorePatterns": [
    "packages/ferrovue/bench/**",
    "packages/ferrovue/fuzz/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@vue/server-renderer",
    "tinybench"
  ],
  "overrides": [
    {
      "files": ["crates/ferrovue/tests/conformance/**"],
      "rules": { "unused-store-members": "off" }
    }
  ],
  "rules": {
    "dev-dependency-in-production": "off",
    "circular-dependencies": "off"
  }
}
