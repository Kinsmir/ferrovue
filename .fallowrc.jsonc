{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "crates/ferrovue/tests/conformance/components/**",
    "crates/ferrovue/tests/conformance/stores/**",
    "crates/ferrovue/tests/conformance/types/**",
    "examples/greeting/components/**",
    "examples/dioxus/components/**",
    "packages/ferrovue/browser/*.test.ts",
    "packages/ferrovue/browser/entry.ts",
    "scripts/inspect.ts"
  ],
  "ignorePatterns": [
    "fuzz/**",
    "**/dist/**",
    "target/**",
    "**/generated/**",
    "examples/fullstack/**",
    "packages/ferrovue/bench/**",
    "packages/ferrovue/fuzz/**"
  ],
  "ignoreExports": [
    { "file": "crates/ferrovue/tests/conformance/**", "exports": ["*"] }
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@vue/server-renderer",
    "tinybench"
  ],
  "overrides": [
    {
      "files": ["crates/ferrovue/tests/conformance/**"],
      "rules": { "unused-store-members": "off" }
    }
  ],
  "rules": {
    "dev-dependency-in-production": "off",
    "circular-dependencies": "off"
  }
}
