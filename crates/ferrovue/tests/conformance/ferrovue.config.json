{
  "components": "components",
  "out": "generated",
  "scopeId": "filepath",
  "viteRoot": "../../../..",
  "routes": "routes.json",
  "stores": "stores",
  "trustedHtml": "crate::Sanitised",
  "helpers": {
    "module": "./helpers",
    "functions": {
      "plural": {
        "rust": "crate::helpers::plural",
        "params": [
          "int"
        ],
        "returns": "string",
        "maxLen": 1
      },
      "tone": {
        "rust": "crate::helpers::tone",
        "params": [
          "int?"
        ],
        "returns": "string",
        "maxLen": 8
      },
      "isEven": {
        "rust": "crate::helpers::is_even",
        "params": [
          "int"
        ],
        "returns": "bool"
      },
      "orDash": {
        "rust": "crate::helpers::or_dash",
        "params": [
          "string?"
        ],
        "returns": "string",
        "maxLen": 1
      }
    }
  },
  "clientDirectives": [
    "focus"
  ],
  "i18n": {
    "messages": "locales",
    "locale": "en",
    "fallbackLocale": "en"
  }
}
