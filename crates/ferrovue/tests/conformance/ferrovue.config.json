{
  "components": "components",
  "out": "generated",
  "scopeId": "filepath",
  "viteRoot": "../../../..",
  "isProduction": false,
  "cssModules": {
    "generateScopedName": "[name]__[local]___[hash:base64:5]"
  },
  "routes": "routes.json",
  "stores": "stores",
  "trustedHtml": "crate::Sanitised",
  "helpers": {
    "module": "./helpers",
    "functions": {
      "plural": {
        "rust": "crate::helpers::plural",
        "params": [
          "int"
        ],
        "returns": "string",
        "maxLen": 1
      },
      "tone": {
        "rust": "crate::helpers::tone",
        "params": [
          "int?"
        ],
        "returns": "string",
        "maxLen": 8
      },
      "isEven": {
        "rust": "crate::helpers::is_even",
        "params": [
          "int"
        ],
        "returns": "bool"
      },
      "orDash": {
        "rust": "crate::helpers::or_dash",
        "params": [
          "string?"
        ],
        "returns": "string",
        "maxLen": 1
      }
    }
  },
  "twins": {
    "StarRating": {
      "rust": "crate::vendor::star_rating",
      "props": {
        "value": "int",
        "max": "int?",
        "label": "string?",
        "readonly": "bool"
      },
      "slots": [
        "default"
      ]
    }
  },
  "clientDirectives": [
    "focus"
  ],
  "i18n": {
    "messages": "locales",
    "locale": "en",
    "fallbackLocale": "en"
  }
}
